const mongoose = require('mongoose');

const paymentSchema = new mongoose.Schema({
  bookingId: { type: mongoose.Schema.Types.ObjectId, ref: 'Booking', required: true },
  customerId: { type: mongoose.Schema.Types.ObjectId, ref: 'Customer', required: true },
  amount: { type: Number, required: true },
  currency: { type: String, default: 'INR' },
  status: { type: String, enum: ['pending', 'captured', 'failed', 'refunded'], default: 'pending' },
  method: { type: String, enum: ['razorpay', 'cash', 'card', 'upi'], required: true },
  transactionId: { type: String }, // Razorpay payment_id
  orderId: { type: String },       // Razorpay order_id
  receipt: { type: String },
  notes: { type: Map, of: String },
}, { timestamps: true });

module.exports = mongoose.model('Payment', paymentSchema);
