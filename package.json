{
  "name": "yash-resort-hms",
  "version": "1.0.0",
  "description": "Yash Resort Hospitality Management System",
  "private": true,
  "scripts": {
    "install-all": "npm install && cd backend && npm install && cd ../yash_resort && npm install && cd ../resort_dashboard && npm install",
    "dev-backend": "cd backend && npm run dev",
    "dev-website": "cd yash_resort && npm run dev",
    "dev-dashboard": "cd resort_dashboard && npm run dev",
    "dev": "npm-run-all --parallel dev-backend dev-website dev-dashboard"
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5"
  }
}
